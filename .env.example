# Contact form email delivery (src/app/api/contact/route.ts). Without RESEND_API_KEY and CONTACT_TO_EMAIL the API returns 503 and the form shows a mailto fallback. The product meeting form (src/app/api/product-meeting/route.ts) uses RESEND_API_KEY and SALES_TO_EMAIL.

# Resend API key (https://resend.com/api-keys); server-only, never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=

# Inbox that receives enquiries.
CONTACT_TO_EMAIL=contact@asauvia.com

# Inbox that receives product meeting requests from /products. Defaults to sales@asauvia.com if unset.
SALES_TO_EMAIL=sales@asauvia.com

# Sender address on a domain verified in Resend; defaults to "Asauvia Website <onboarding@resend.dev>" if unset.
CONTACT_FROM_EMAIL="Asauvia Website <website@asauvia.com>"

# Cloudflare Turnstile secret; when set, the API rejects submissions without a valid token.
TURNSTILE_SECRET_KEY=

# Cloudflare Turnstile site key; when set, the form loads and renders the Turnstile widget. Set together with TURNSTILE_SECRET_KEY.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google Search Console HTML-tag verification token (content value only); omitted from <head> when unset.
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools msvalidate.01 token (content value only); omitted from <head> when unset.
BING_SITE_VERIFICATION=

# IndexNow key used by `npm run indexnow`; must match public/<key>.txt. Defaults to the committed key file.
INDEXNOW_KEY=
