# Copy to .env.local and fill in. Values starting with NEXT_PUBLIC_ are built into the site,
# so a change needs a new build and deploy.

# Google Analytics 4 measurement ID (for example G-XXXXXXXXXX). Leave empty to turn analytics off.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# AdSense client ID (ca-pub-...). Used for the site verification tag and, later, the ad units.
NEXT_PUBLIC_ADSENSE_CLIENT=

# AdSense ad unit ID. Set only after AdSense approves the site and the unit is created.
NEXT_PUBLIC_ADSENSE_SLOT=

# Show every post, including ones dated in the future (default). Set to false to release posts by their date.
SHOW_SCHEDULED_POSTS=

# Search Console and Bing Webmaster verification tokens (content values only).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
